# Vercel Environment Variables
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Use one of these, depending on your deployment setup:
RESEND_FROM_EMAIL=RISE <hello@your-verified-domain.com>
RISE_ADMIN_EMAIL=you@example.com
BULK_RESEND_TOKEN=generate-a-long-random-secret
WAITLIST_ADMIN_TOKEN=generate-a-different-long-random-secret
# or
EMAIL_FROM=RISE <hello@your-verified-domain.com>
